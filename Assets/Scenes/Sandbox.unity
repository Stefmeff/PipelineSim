  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#647BCAFF>USAGE INFO:</color></b>\n\n</b>Drag and drop components
    from the library on the left\n\n</b>Connect components by left clicking on an
    output pin and dragging the mouse to an input pin\n\n</b>While drawing a wire,
    create intermediate wire knots by left clicking\n\n</b>While drawing a wire,
    press ctrl to draw straight wires and align connected objects\n\n</b>Right click
    on a component to open its editor and enter parameters\n\n</b>Save project with 
    <color=#647BCAFF>SAVE</color> button on the top left\n\n</b>Load project with 
    <color=#647BCAFF>LOAD</color> button on the top left\n\n</b>Start <sprite name=\"start\"
    color=#647BCAFF>, pause <sprite name=\"pause\" color=#647BCAFF> and reset <sprite
    name=\"reset\" color=#647BCAFF> simulation with the respective buttons in the
    top menu\n\n</b>Set simulation speed in <color=#647BCAFF>TIME</color> section\n\n</b>Step
    through the simulation with the <sprite name=\"step\" color=#647BCAFF> button
    and set the step size in the <color=#647BCAFF>STEP</color> section. Leave the
    step through mode by either resuming or resetting the simulation.\n\n</b>Find
    center of project with magnifying glass button  <sprite name=\"zoom\" color=#647BCAFF>\n\n</b>Rotate
    object: <b>Strg+R</b> or rotation button  <sprite name=\"rotate\" color=#647BCAFF>\n\n</b>Delete
    object via <b>Entf</b> or delete button  <sprite name=\"delete\" color=#647BCAFF>\n\n</b>Delete
    project with the bin icon on the top right \n\n\n\n\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
